#!/bin/sh

if [ "$INVESTMENTS_MCP_TRANSPORT" = "stdio" ]; then
    echo "INFO: starting investments-mcp in stdio mode" >&2
    exec investments-mcp "$@"
else
    echo "INFO: starting investments-mcp with mcp-proxy (native MCP/SSE)" >&2
    exec mcp-proxy --pass-environment --host 0.0.0.0 --port 8001 -- investments-mcp "$@"
fi
