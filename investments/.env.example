# Investments MCP configuration. Copy to .env and fill in real values.

# Connection string for the dedicated investments database on LGA Postgres.
# Use the investments role, which has no access to other databases.
# Format: postgres://investments:<password>@lga-postgres:5432/investments?sslmode=disable
INVESTMENTS_MCP_DSN=

# Per-query timeout. Go duration. Default 30s.
INVESTMENTS_MCP_QUERY_TIMEOUT=30s

# A price this many days or more older than the reference date is stale and
# unusable for valuation. Default 5.
INVESTMENTS_MCP_STALE_PRICE_DAYS=5

# Tiingo API key, the market data credential. Server-side secret, never logged
# or returned to clients. Rotate by restarting with a new value.
INVESTMENTS_MCP_TIINGO_API_KEY=

# Transport used by the container entrypoint: mcp-proxy or stdio.
# INVESTMENTS_MCP_TRANSPORT=mcp-proxy

# Host name peers use to reach the container (mcp-proxy rejects unknown Host headers).
# INVESTMENTS_MCP_ALLOWED_HOST=mcpinvestments

# Path of the notifications YAML file (channels, categories and routes). Read on
# every outbox pass. Unset or missing means unconfigured: notifications are
# logged as undelivered. The file holds no secrets.
# INVESTMENTS_MCP_NOTIFICATIONS_CONFIG_FILE=

# Telegram bot token for the notifications file's telegram channels. Server-side
# secret, never logged or returned. Empty: telegram channels log as undelivered.
# INVESTMENTS_MCP_TELEGRAM_BOT_TOKEN=

# Optional tunables. Every one has a default, shown here, and none is needed.

# IANA time zone of the market day: the daily job and monitors run in it, and
# "today" is its calendar date.
# INVESTMENTS_MCP_MARKET_TIMEZONE=America/New_York

# Most points one get_value_history query returns.
# INVESTMENTS_MCP_MAX_HISTORY_POINTS=1000

# Event outbox: failures before giving up on an event, the delay after the first
# failure (doubling), how long after recording an event is still handled, and how
# long a fully handled event is kept.
# INVESTMENTS_MCP_EVENT_MAX_FAILURES=10
# INVESTMENTS_MCP_EVENT_BACKOFF_BASE=30s
# INVESTMENTS_MCP_EVENT_MAX_AGE=168h
# INVESTMENTS_MCP_EVENT_RETENTION=8760h

# Notifications worker: poll and prune intervals, events per pass, one handler
# call deadline. Monitors: one run deadline.
# INVESTMENTS_MCP_WORKER_POLL_INTERVAL=30s
# INVESTMENTS_MCP_WORKER_PRUNE_INTERVAL=24h
# INVESTMENTS_MCP_WORKER_BATCH_LIMIT=100
# INVESTMENTS_MCP_WORKER_HANDLER_TIMEOUT=30s
# INVESTMENTS_MCP_MONITOR_TIMEOUT=2m
