# Investments MCP configuration. Copy to .env and fill in real values.

# Connection string for the dedicated mcpinvestments database on LGA Postgres.
# Use the mcpinvestments role, which has no access to other databases.
# Format: postgres://mcpinvestments:<password>@lga-postgres:5432/mcpinvestments?sslmode=disable
INVESTMENTS_MCP_DSN=

# Per-query timeout. Go duration. Default 30s.
INVESTMENTS_MCP_QUERY_TIMEOUT=30s

# A price this many days or more older than the reference date is stale and
# unusable for valuation. Default 5.
INVESTMENTS_MCP_STALE_PRICE_DAYS=5

# Tiingo API key, the market data credential. Server-side secret, never logged
# or returned to clients. Rotate by restarting with a new value.
INVESTMENTS_MCP_TIINGO_API_KEY=

# Transport used by the container entrypoint: mcp-proxy or stdio.
# INVESTMENTS_MCP_TRANSPORT=mcp-proxy
