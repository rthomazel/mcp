set -euo pipefail
shopt -s globstar
trap 'echo fatal: $0:$LINENO >&2' ERR

cd "$(dirname "$0")"

cmd="${1:-help}"

build_arch() {
  version="$(git describe --tags --abbrev=0 --match 'investments/*')"
  version="${version#investments/}"
  commit="$(git rev-parse --short HEAD)"
  date="$(date +%Y.%m.%d.%H:%M)"

  docker buildx build --platform "$1" \
    --build-arg VERSION="${version}_${commit}_$date" \
    -t ghcr.io/rthomazel/mcp/investments:latest \
    --load .
}

case "$cmd" in
# -- generate mocks, run before test and lint
mocks)
  go tool mockery
  ;;
# -- run golangci-lint
lint)
  go tool golangci-lint run ./...
  ;;
# -- start the server on stdio, reads .env
dev)
  set -a
  [[ -f .env ]] && source .env
  set +a
  go run ./cmd/investments
  ;;
# -- run tests, set INVESTMENTS_MCP_TEST_DSN to include the database tests
test)
  go test -race ./...
  ;;
# -- run formatters
format)
  go tool gofumpt -l -w .
  oxfmt .
  ;;
# -- build local binary to bin/investments-mcp
build:go)
  go build -o bin/investments-mcp ./cmd/investments
  ;;
# -- build versioned docker image for amd64
build:amd64)
  build_arch "linux/amd64"
  ;;
# -- build versioned docker image for arm64
build:arm64)
  build_arch "linux/arm64"
  ;;
help | *)
  echo "Usage: investments/run <command>"
  echo ""
  echo "Commands:"
  awk '/^# -- /{desc=substr($0, index($0,"-- ")+3)} /\)$/ && desc{cmd=$0; gsub(/[[:space:]()|*]/, "", cmd); printf "  %-20s %s\n", cmd, desc; desc=""}' "$(basename "$0")"
  ;;
esac
